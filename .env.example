# Optional fallbacks used when the chat settings are left blank.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Leave tracing off. The LangGraph dev server stores run config locally.
LANGSMITH_TRACING=false

# Auth database. Created automatically.
GSB_AUTH_DB=data/auth.db

# Verification links expire after this many seconds. Default is 24 hours.
# GSB_VERIFICATION_TTL_SECONDS=86400

# Public URL written into verification links and the Google redirect URI.
# The browser talks to this origin. Next.js proxies /api to the auth server,
# including /api/auth/google/callback. On Railway set this to the web service
# origin, for example https://web-production-346c6.up.railway.app
APP_BASE_URL=http://localhost:3000

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to hide the button.
# The authorized redirect URI is ${APP_BASE_URL}/api/auth/google/callback
# with no trailing slash. Register every origin you open in a browser:
#   http://127.0.0.1:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
#   https://web-production-346c6.up.railway.app/api/auth/google/callback
# Do not commit the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave SMTP_HOST empty to print the verification link in the auth server log.
# Resend over SMTP uses STARTTLS on port 587, not implicit SSL.
# Replace yourdomain.com with a domain you have verified in Resend.
# SMTP_PASSWORD is the Resend API key. Do not commit it.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<Resend API key>
# SMTP_FROM=GSB Chef <no-reply@yourdomain.com>
# SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=GSB Chef <no-reply@yourdomain.com>
SMTP_TLS=true

AUTH_HOST=127.0.0.1
AUTH_PORT=8000
