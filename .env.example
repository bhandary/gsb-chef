# Optional fallbacks used when the chat settings are left blank.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Leave tracing off. The LangGraph dev server stores run config locally.
LANGSMITH_TRACING=false

# Auth database. Created automatically.
GSB_AUTH_DB=data/auth.db

# Verification links expire after this many seconds. Default is 24 hours.
# GSB_VERIFICATION_TTL_SECONDS=86400

# Public URL written into verification links.
APP_BASE_URL=http://localhost:3000

# Leave SMTP_HOST empty to print the verification link in the auth server log.
# Resend over SMTP uses STARTTLS on port 587, not implicit SSL.
# Replace yourdomain.com with a domain you have verified in Resend.
# SMTP_PASSWORD is the Resend API key. Do not commit it.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<Resend API key>
# SMTP_FROM=GSB Chef <no-reply@yourdomain.com>
# SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=GSB Chef <no-reply@yourdomain.com>
SMTP_TLS=true

AUTH_HOST=127.0.0.1
AUTH_PORT=8000
