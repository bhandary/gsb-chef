# LangGraph server the chat UI talks to.
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
NEXT_PUBLIC_AUTH_SCHEME=

# Account server. Read by the Next.js server, not the browser.
# The browser only talks to this web origin. /api/auth and /api/auth/google
# are proxied here, and /api/* to LangGraph requires a gsb_session cookie.
AUTH_API_URL=http://127.0.0.1:8000
